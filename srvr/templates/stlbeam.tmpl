
{{template "header" .}}
<body>
  <div class="nes-container" width="fit-content">
    <div>
      <a href="/docs/steel/beam" class="nes-btn is-success" style="float:right">?</a>
      <center><h3 class="nes-text is-primary">Steel beam data:</h3></center>
      <form action="/steel/beam" method="post" autocomplete="on">

	<!-- <label><input type="radio" class="nes-radio" name="Dsgn" value="true" checked /><span>design</span></label> -->
	<!-- <label><input type="radio" class="nes-radio" name="Dsgn" value="false"/><span>check section</span></label> -->
	<!-- <br> -->		
	<span>check for bearing?</span>
	<label><input type="radio" class="nes-radio" name="Brchk" value="true" checked /><span>yes</span></label>
	<label><input type="radio" class="nes-radio" name="Brchk" value="false"/><span>no</span></label>
	<br>

	<span>is laterally supported?</span>
	<label><input type="radio" class="nes-radio" name="Lsb" value="true" checked /><span>yes</span></label>
	<label><input type="radio" class="nes-radio" name="Lsb" value="false"/><span>no</span></label>
	<br>	

	<div class="nes-select">
	  <label for="Dtyp">end condition</label>
	  <select name="Dtyp" id="Dtyp">
	    <option value=-1>clvr beam</option>
	    <option value=1 selected="selected">s.s beam</option>
	    <option value=2>cs beam</option>
	  </select>
	</div>
	<div class="nes-select">
	  <label for="Sname">section name</label>
	  <select name="Sname" id="Sname">
	    <option value="ismb">ismb</option>
	    <option value="i">i-section</option>
	    <option value="ub" selected="selected">ub</option>
	    <option value="uc">uc</option>
	    <option value="npb">npb</option>
	    <option value="wpb">wpb</option>
	    <option value="w">w</option>
	    <option value="built-i">built-i</option>
	    <option value="plate-i">plate-i</option>
	    <option value="shs">shs</option>
	    <option value="rhs">rhs</option>
	  </select>
	</div>
	
	<div class="nes-select">
	  <label for="Code">code of practice</label>
	  <select name="Code" id="Code">
	    <option value=1>is.800</option>
	    <option value=2 selected="selected">bs.449</option>
	  </select>
	</div>
	<div class="nes-select">
	  <label for="Term">gnuplot terminal</label>
	  <select name="Term" id="Term">
	    <option value="svg" selected="selected">svg</option>
	    <option value="dxf">dxf</option>
	    <option value="svgmono">svgmono</option>
	  </select>
	</div>

	
	<label for="Title">title</label>
	<input type="text" name="Title" class="nes-input" placeholder="mosley-ex-6.2" value="mosley-ex-6.2" onfocus = "this.value=''"/>
	
	<label for="Lspan">span length(mm)</label>
	<input type="text" name="Lspan" class="nes-input" placeholder="6000.0" value="6000.0" onfocus = "this.value=''"/>

	
	<label for="Tx">fixity factor</label>
	<input type="text" name="Tx" class="nes-input" placeholder="1.0" value="1.0" onfocus = "this.value=''"/>

	<label for="Lcf">c.f unbraced length(mm)</label>
	<input type="text" name="Lcf" class="nes-input" placeholder="6000.0" value="6000.0" onfocus = "this.value=''"/>
	
	
	<label for="Tcf">c.f fixity factor</label>
	<input type="text" name="Tcf" class="nes-input" placeholder="1.0" value="1.0" onfocus = "this.value=''"/>
	
	<label for="Lbr">length of bearing(mm)</label>
	<input type="text" name="Lbr" class="nes-input" placeholder="200.0" value="200.0" onfocus = "this.value=''"/>
	<label for="Tbr">thickness of bearing plate(mm)</label>
	<input type="text" name="Tbr" class="nes-input" placeholder="20.0" value="20.0" onfocus = "this.value=''"/>
	<label for="DL">dead load(n/mm)</label>
	<input type="text" name="DL" class="nes-input" placeholder="0.0" value="0.0" onfocus = "this.value=''"/>
	<label for="LL">live load(n/mm)</label>
	<input type="text" name="LL" class="nes-input" placeholder="0.0" value="0.0" onfocus = "this.value=''"/>

	<label for="Ldcases">load cases</label>
	<input type="text" name="Ldcases" class="nes-input" placeholder="[1,3,100,0,0,0,1],[1,3,160,0,2000,1000,2]"  value="[1,3,100,0,0,0,1],[1,3,160,0,2000,1000,2]" onfocus = "this.value=''"/>
	<label for="Json" class="nes-text is-warning">json input</label>
	<textarea name="Json" id="Json" class="nes-textarea"></textarea>

	<div style="text-align: center">
	  <input type="submit" class="nes-btn is-primary" value="calc"/>
	</div>
      </form>
    </div>
</body>
{{template "footer" .}}
